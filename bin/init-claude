#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# init-claude - Scaffold complete .claude/ directory with best practices
# ============================================================================
# Version: 2.0.0
# Usage: init-claude [project-name] [--skip-claudekit] [--skip-skills-repo]
# ============================================================================

# ANSI colors
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
BLUE='\033[34m'
MAGENTA='\033[35m'
RESET='\033[0m'

info() { echo -e "${CYAN}[INFO]${RESET} $1"; }
ok() { echo -e "${GREEN}[OK]${RESET} $1"; }
warn() { echo -e "${YELLOW}[WARN]${RESET} $1"; }
step() { echo -e "${BLUE}▸${RESET} $1"; }

# ============================================================================
# Parse Arguments
# ============================================================================
SKIP_CLAUDEKIT=false
SKIP_SKILLS_REPO=false
PROJECT_NAME=""

for arg in "$@"; do
    case "$arg" in
        --skip-claudekit) SKIP_CLAUDEKIT=true ;;
        --skip-skills-repo) SKIP_SKILLS_REPO=true ;;
        -*) warn "Unknown flag: $arg" ;;
        *) PROJECT_NAME="$arg" ;;
    esac
done

if [[ -z "$PROJECT_NAME" ]]; then
    PROJECT_NAME=$(basename "$(pwd)")
    info "No project name provided, using current directory: $PROJECT_NAME"
fi

# ============================================================================
# Check Prerequisites
# ============================================================================
info "Checking prerequisites..."

if ! command -v claude &>/dev/null; then
    warn "Claude CLI not found. Install with: npm install -g @anthropic-ai/claude-code"
    warn "Continuing anyway - you can install it later"
fi

# ============================================================================
# Create Directory Structure
# ============================================================================
info "Creating .claude/ directory structure..."

CLAUDE_DIR=".claude"

if [[ -d "$CLAUDE_DIR" ]]; then
    warn ".claude/ already exists. Backing up to .claude.backup-$(date +%s)"
    mv "$CLAUDE_DIR" ".claude.backup-$(date +%s)"
fi

# Create directory tree
mkdir -p "$CLAUDE_DIR"/{hooks,skills,memory,agents,commands,workflows,scripts}

ok "Directory structure created"

# ============================================================================
# Install ClaudeKit (agents, commands, hooks, workflows)
# ============================================================================
if [[ "$SKIP_CLAUDEKIT" == "false" ]]; then
    info "Installing ClaudeKit (agents, commands, hooks, workflows)..."

    if command -v npx &>/dev/null; then
        step "Running claudekit setup --all --yes..."
        npx claudekit setup --all --yes 2>/dev/null && ok "ClaudeKit installed" || {
            warn "ClaudeKit setup failed. Continuing with basic scaffold."
            warn "You can install later: npx claudekit setup --all --yes"
        }
    else
        warn "npx not found. Skipping ClaudeKit installation."
        warn "Install Node.js, then run: npx claudekit setup --all --yes"
    fi
else
    info "Skipping ClaudeKit installation (--skip-claudekit flag)"
fi

# ============================================================================
# Install ClaudeKit Skills Repository
# ============================================================================
if [[ "$SKIP_SKILLS_REPO" == "false" ]]; then
    info "Installing ClaudeKit skills repository..."

    if command -v git &>/dev/null; then
        if [[ -d "$CLAUDE_DIR/skills/.git" ]]; then
            step "Skills repo already exists, updating..."
            (cd "$CLAUDE_DIR/skills" && git pull --quiet 2>/dev/null) && ok "Skills repo updated" || warn "Skills repo update failed"
        else
            step "Cloning skills repository..."
            # Save any existing custom skills
            CUSTOM_SKILLS_BACKUP=""
            if [[ -d "$CLAUDE_DIR/skills/seo-optimization" ]] || [[ -d "$CLAUDE_DIR/skills/ios-pro" ]] || [[ -d "$CLAUDE_DIR/skills/react-typescript" ]]; then
                CUSTOM_SKILLS_BACKUP=$(mktemp -d)
                for skill in seo-optimization ios-pro react-typescript; do
                    [[ -d "$CLAUDE_DIR/skills/$skill" ]] && cp -r "$CLAUDE_DIR/skills/$skill" "$CUSTOM_SKILLS_BACKUP/"
                done
            fi

            # Clone into a temp dir and merge
            TEMP_SKILLS=$(mktemp -d)
            git clone --depth 1 --quiet https://github.com/anthropics/claude-code-skills.git "$TEMP_SKILLS" 2>/dev/null && {
                # Copy skills (but preserve existing custom ones)
                cp -rn "$TEMP_SKILLS"/* "$CLAUDE_DIR/skills/" 2>/dev/null || true
                cp -rn "$TEMP_SKILLS"/.[!.]* "$CLAUDE_DIR/skills/" 2>/dev/null || true
                rm -rf "$TEMP_SKILLS"
                ok "Skills repository installed"
            } || {
                warn "Failed to clone skills repo. Continuing without."
                warn "You can install later: cd .claude/skills && git clone https://github.com/anthropics/claude-code-skills.git ."
            }

            # Restore custom skills
            if [[ -n "$CUSTOM_SKILLS_BACKUP" ]] && [[ -d "$CUSTOM_SKILLS_BACKUP" ]]; then
                cp -r "$CUSTOM_SKILLS_BACKUP"/* "$CLAUDE_DIR/skills/" 2>/dev/null || true
                rm -rf "$CUSTOM_SKILLS_BACKUP"
            fi
        fi
    else
        warn "git not found. Skipping skills repo installation."
    fi
else
    info "Skipping skills repo installation (--skip-skills-repo flag)"
fi

# ============================================================================
# Install Personal Skills from t-code4change/claude-skills
# ============================================================================
info "Installing personal skills from t-code4change/claude-skills..."

if command -v git &>/dev/null; then
    PERSONAL_SKILLS_TEMP=$(mktemp -d)
    git clone --depth 1 --quiet https://github.com/t-code4change/claude-skills.git "$PERSONAL_SKILLS_TEMP" 2>/dev/null && {
        # Install all skills (skip non-skill files/dirs)
        for skill_dir in "$PERSONAL_SKILLS_TEMP"/*/; do
            skill_name=$(basename "$skill_dir")
            # Skip non-skill items
            [[ "$skill_name" == "bin" ]] && continue
            [[ ! -f "$skill_dir/SKILL.md" ]] && [[ ! -f "$skill_dir/README.md" ]] && continue
            mkdir -p "$CLAUDE_DIR/skills/$skill_name"
            cp -r "$skill_dir"* "$CLAUDE_DIR/skills/$skill_name/" 2>/dev/null || true
            step "  ✓ $skill_name"
        done
        # Install personal commands (bin/commands/ → .claude/commands/)
        if [[ -d "$PERSONAL_SKILLS_TEMP/bin/commands" ]]; then
            mkdir -p "$CLAUDE_DIR/commands"
            cp -r "$PERSONAL_SKILLS_TEMP/bin/commands/"* "$CLAUDE_DIR/commands/" 2>/dev/null || true
            step "  ✓ personal commands"
        fi
        rm -rf "$PERSONAL_SKILLS_TEMP"
        ok "Personal skills installed"
    } || {
        rm -rf "$PERSONAL_SKILLS_TEMP" 2>/dev/null || true
        warn "Could not clone personal skills. Run manually: git clone https://github.com/t-code4change/claude-skills ~/claude-skills && ~/claude-skills/install.sh all"
    }
else
    warn "git not found. Skipping personal skills installation."
fi

# ============================================================================
# Create settings.json - Optimized Configuration
# ============================================================================
step "Creating settings.json..."

cat > "$CLAUDE_DIR/settings.json" <<'EOF'
{
  "model": "sonnet",
  "permission_mode": "ask",
  "auto_approve_safe_tools": true,
  "auto_approve_read_tools": true,
  "context_window_optimization": {
    "auto_compress": true,
    "preserve_recent_turns": 20
  },
  "experimental": {
    "parallel_tool_calls": true,
    "skill_autoloading": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Glob|Grep|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scout-block/hook.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/scripts/statusline.sh",
    "padding": 0
  }
}
EOF

ok "settings.json created"

# ============================================================================
# Create keybindings.json - Productivity Shortcuts
# ============================================================================
step "Creating keybindings.json..."

cat > "$CLAUDE_DIR/keybindings.json" <<'EOF'
{
  "ctrl+shift+p": "/plan",
  "ctrl+shift+c": "/cook",
  "ctrl+shift+t": "/test",
  "ctrl+shift+f": "/fix",
  "ctrl+shift+r": "/review:codebase",
  "ctrl+shift+d": "/design:fast"
}
EOF

ok "keybindings.json created"

# ============================================================================
# Create Hooks
# ============================================================================
info "Creating hooks for security and quality..."

# Scout-block hook (security)
mkdir -p "$CLAUDE_DIR/hooks/scout-block"
cat > "$CLAUDE_DIR/hooks/scout-block/hook.sh" <<'EOF'
#!/usr/bin/env bash
# Scout-block hook: Prevent accidental exposure of sensitive files

# Block patterns
SENSITIVE_PATTERNS=(
    "*.env"
    "*.pem"
    "*.key"
    "*credentials*"
    "*secrets*"
    "*.p12"
    ".npmrc"
)

# Check if any tools are accessing sensitive files
for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    if echo "$CLAUDE_TOOLS" | grep -q "$pattern"; then
        echo "⛔️ BLOCKED: Attempting to access sensitive file matching: $pattern"
        echo "💡 Tip: Add this pattern to .claudeignore if needed"
        exit 1
    fi
done

exit 0
EOF
chmod +x "$CLAUDE_DIR/hooks/scout-block/hook.sh"

cat > "$CLAUDE_DIR/hooks/scout-block/config.json" <<'EOF'
{
  "trigger": "before_tool_call",
  "tools": ["Read", "Glob", "Grep"],
  "enabled": true
}
EOF

# Format validation hook
mkdir -p "$CLAUDE_DIR/hooks/format-check"
cat > "$CLAUDE_DIR/hooks/format-check/hook.sh" <<'EOF'
#!/usr/bin/env bash
# Format-check hook: Validate code formatting before write

FILE_PATH="$1"
FILE_EXT="${FILE_PATH##*.}"

case "$FILE_EXT" in
    ts|tsx|js|jsx)
        if command -v prettier &>/dev/null; then
            prettier --check "$FILE_PATH" 2>/dev/null || {
                echo "⚠️  Code formatting issue detected in $FILE_PATH"
                echo "💡 Run: prettier --write \"$FILE_PATH\""
            }
        fi
        ;;
    swift)
        if command -v swiftformat &>/dev/null; then
            swiftformat --lint "$FILE_PATH" 2>/dev/null || {
                echo "⚠️  Swift formatting issue detected"
            }
        fi
        ;;
esac

exit 0
EOF
chmod +x "$CLAUDE_DIR/hooks/format-check/hook.sh"

cat > "$CLAUDE_DIR/hooks/format-check/config.json" <<'EOF'
{
  "trigger": "before_write",
  "enabled": false,
  "note": "Enable by setting enabled: true. Requires prettier/swiftformat installed."
}
EOF

ok "Hooks created (scout-block, format-check)"

# ============================================================================
# Create Example Commands
# ============================================================================
info "Creating example commands..."

mkdir -p "$CLAUDE_DIR/commands"

cat > "$CLAUDE_DIR/commands/quick-fix.md" <<'EOF'
---
description: ⚡ Quickly analyze and fix small issues
argument-hint: [issue description]
---

You are in **Quick Fix Mode**. Your goal is to analyze and fix the issue as quickly as possible.

## Issue
<issue>$ARGUMENTS</issue>

## Approach
1. Read relevant files
2. Identify root cause
3. Apply minimal fix
4. Verify it works

## Rules
- **Fast over perfect** - Get it working, then refine if needed
- **Minimal changes** - Touch only what's necessary
- **No over-engineering** - Resist the urge to refactor unrelated code
- **Test the fix** - Run relevant tests or manual verification

Start by reading the most likely problematic files.
EOF

cat > "$CLAUDE_DIR/commands/feature.md" <<'EOF'
---
description: ⚡⚡ Plan and implement a new feature
argument-hint: [feature description]
---

You are implementing a new feature. Follow this process:

## Feature Request
<feature>$ARGUMENTS</feature>

## Process

### 1. Clarify Requirements (use AskUserQuestion if unclear)
- What exactly should this feature do?
- What are the edge cases?
- What's the expected behavior?

### 2. Plan Approach
- Identify affected files
- List implementation steps
- Consider architecture impact

### 3. Implement
- Write clean, tested code
- Follow existing patterns
- Keep it simple (YAGNI, KISS, DRY)

### 4. Verify
- Run tests
- Manual testing
- Update documentation

Start by clarifying requirements if anything is unclear.
EOF

ok "Example commands created (quick-fix, feature)"

# ============================================================================
# Create Workflows
# ============================================================================
info "Creating workflow documents..."

mkdir -p "$CLAUDE_DIR/workflows"

cat > "$CLAUDE_DIR/workflows/development-rules.md" <<'EOF'
# Development Rules

Core principles for all code changes in this project.

## Code Quality

### YAGNI (You Aren't Gonna Need It)
- Don't add functionality until it's necessary
- Resist premature abstraction
- Build for today's requirements, not imagined future ones

### KISS (Keep It Simple, Stupid)
- Simplest solution that works is usually best
- Prefer explicit over clever
- Optimize for readability, not cleverness

### DRY (Don't Repeat Yourself)
- Extract repeated logic into functions
- Use abstractions when they reduce duplication
- But don't DRY too early (wait for 3rd repetition)

## Testing
- Write tests for new features
- Fix tests when modifying existing code
- Aim for >70% coverage on critical paths

## Documentation
- Update README when changing public APIs
- Add comments for non-obvious logic
- Keep CLAUDE.md in sync with architecture changes

## Git Workflow
- Atomic commits (one logical change per commit)
- Descriptive commit messages
- Review diff before committing

## Performance
- Don't optimize prematurely
- Profile before optimizing
- Document performance-critical code

## Security
- Never commit secrets (.env, API keys, credentials)
- Validate user input
- Use parameterized queries (prevent SQL injection)
- Sanitize output (prevent XSS)
EOF

cat > "$CLAUDE_DIR/workflows/orchestration-protocol.md" <<'EOF'
# Orchestration Protocol

How to coordinate complex tasks involving multiple steps or agents.

## When to Use
- Feature spans multiple files/modules
- Requires sequential steps
- Benefits from parallelization
- Needs coordination between subsystems

## Protocol

### 1. Decompose
Break task into logical subtasks:
- Each subtask should be independently testable
- Identify dependencies between subtasks
- Estimate complexity (simple/medium/complex)

### 2. Plan Execution Strategy
**Sequential**: Tasks depend on each other
```
A → B → C → D
```

**Parallel**: Independent tasks
```
A ─┬─ B
   ├─ C
   └─ D
```

**Hybrid**: Mixed dependencies
```
A → B ─┬─ C
       └─ D → E
```

### 3. Execute
- Start with foundations (data models, core logic)
- Then build features on top
- Finish with integration and testing

### 4. Verify
- Unit tests for each component
- Integration tests for interactions
- Manual testing of end-to-end flow

## Example

Task: "Add user authentication"

Decomposition:
1. User model + DB migration (foundation)
2. Auth service (business logic)
3. Auth endpoints (API)
4. Auth UI components (frontend)
5. Integration tests

Execution: Sequential 1→2→3, then parallel 4, then 5
EOF

ok "Workflows created (development-rules, orchestration-protocol)"

# ============================================================================
# Create StatusLine Script
# ============================================================================
info "Creating statusline script..."

mkdir -p "$CLAUDE_DIR/scripts"

cat > "$CLAUDE_DIR/scripts/statusline.sh" <<'EOF'
#!/usr/bin/env bash
# Simple statusline showing git branch and status

if command -v git &>/dev/null && git rev-parse --git-dir &>/dev/null 2>&1; then
    BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

    # Check if working directory is clean
    if git diff-index --quiet HEAD -- 2>/dev/null; then
        STATUS="✓"
    else
        STATUS="●"
    fi

    echo "[$BRANCH $STATUS]"
else
    echo "[no git]"
fi
EOF
chmod +x "$CLAUDE_DIR/scripts/statusline.sh"

ok "StatusLine script created"

# ============================================================================
# Create iOS Pro Skill
# ============================================================================
info "Creating skills..."

mkdir -p "$CLAUDE_DIR/skills/ios-pro"

cat > "$CLAUDE_DIR/skills/ios-pro/README.md" <<'EOF'
# iOS Development Pro Skill

Professional iOS development following 2024-2026 best practices.

## Stack Recommendations

### Small Apps (<10 screens)
- SwiftUI + MVVM
- URLSession + async/await
- SwiftData (iOS 17+)
- NavigationStack

### Medium Apps (10-20 screens)
- SwiftUI + MVVM + Coordinator
- URLSession + async/await
- SwiftData or Core Data
- Dependency Injection (Factory)

### Large Apps (20+ screens)
- SwiftUI + TCA (Composable Architecture)
- Alamofire + Moya
- Core Data + caching layer
- TCA Navigation

## Trending UI (2024-2026)

**Glassmorphism** - Primary trend:
```swift
.background(.ultraThinMaterial)
.cornerRadius(16)
.overlay(
    RoundedRectangle(cornerRadius: 16)
        .stroke(Color.white.opacity(0.2), lineWidth: 1)
)
```

## Essential Tools

- **XcodeGen/Tuist**: Project generation
- **SwiftGen**: Type-safe resources (9.2k stars)
- **Fastlane**: Build/deploy automation
- **SwiftLint**: Code quality
- **Lottie**: Animations (native SwiftUI 4.3+)
- **Kingfisher**: Image caching (pure Swift)

## Dependencies

**Always use Swift Package Manager (SPM), never CocoaPods**

Popular libraries:
- Alamofire (42k stars) - Networking
- Kingfisher (23k stars) - Image loading
- Lottie (25k stars) - Animations
- SnapKit (20k stars) - Auto Layout DSL
- SwiftLint (18k stars) - Linting

## Build Configuration

### project.yml (XcodeGen)
```yaml
name: YourApp
options:
  bundleIdPrefix: com.yourcompany
  deploymentTarget:
    iOS: 17.0
settings:
  SUPPORTED_PLATFORMS: "iphoneos iphonesimulator"
  SUPPORTS_MACCATALYST: false
  SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD: false

targets:
  YourApp:
    type: application
    platform: iOS
    sources: [Sources]

  YourAppTests:
    type: bundle.unit-test
    platform: iOS
    sources: [Tests]
```

### Fastfile
```ruby
default_platform(:ios)

platform :ios do
  desc "Build and run on simulator"
  lane :sim do
    scan(
      scheme: "YourApp",
      destination: "platform=iOS Simulator,name=iPhone 15 Pro"
    )
  end

  desc "Run tests"
  lane :test do
    scan(scheme: "YourApp")
  end
end
```

## Critical Build Rules

1. **UNIQUE FILENAMES**: Every .swift file must have unique name across entire project
   - Xcode treats filenames as flat namespace
   - Bad: `Views/Home/ContentView.swift` + `Views/Profile/ContentView.swift`
   - Good: `HomeContentView.swift` + `ProfileContentView.swift`

2. **Test Target Type**: Use `bundle.unit-test` not `unitTests`

3. **No CocoaPods**: Only SPM dependencies

## Architecture Patterns

### MVVM Example
```swift
// Model
struct Event: Identifiable {
    let id: UUID
    var title: String
    var date: Date
}

// ViewModel
@Observable
class EventsViewModel {
    var events: [Event] = []

    func loadEvents() async {
        // Business logic here
    }
}

// View
struct EventsView: View {
    @State private var viewModel = EventsViewModel()

    var body: some View {
        List(viewModel.events) { event in
            EventRow(event: event)
        }
        .task {
            await viewModel.loadEvents()
        }
    }
}
```

### Glassmorphism UI
```swift
struct GlassCard<Content: View>: View {
    let content: Content

    init(@ViewBuilder content: () -> Content) {
        self.content = content()
    }

    var body: some View {
        content
            .padding()
            .background(.ultraThinMaterial)
            .cornerRadius(16)
            .overlay(
                RoundedRectangle(cornerRadius: 16)
                    .stroke(Color.white.opacity(0.2), lineWidth: 1)
            )
            .shadow(color: .black.opacity(0.1), radius: 10, y: 5)
    }
}
```

## Testing

### XCTest + Snapshot Testing
```swift
import XCTest
import SnapshotTesting
@testable import YourApp

final class EventsViewTests: XCTestCase {
    func testEventsView() {
        let view = EventsView()
        assertSnapshot(matching: view, as: .image)
    }
}
```

## Common Pitfalls

1. ❌ Using @Query in SwiftData (causes crashes)
   ✅ Use @State + modelContext.fetch() instead

2. ❌ Mixing UIKit and SwiftUI unnecessarily
   ✅ Pure SwiftUI for new projects

3. ❌ Not using @Observable (iOS 17+)
   ✅ Replace ObservableObject with @Observable

4. ❌ Hardcoded colors/strings
   ✅ Use SwiftGen for type-safe resources

## Production Checklist

- [ ] SwiftLint configured and passing
- [ ] SwiftGen for assets/strings
- [ ] Unit tests >70% coverage
- [ ] Snapshot tests for key screens
- [ ] Fastlane configured
- [ ] Error handling implemented
- [ ] Accessibility labels added
- [ ] Dark mode supported
- [ ] iPad layout tested
- [ ] Performance profiled (Instruments)

## Activation

When building iOS apps, Claude will automatically use these guidelines if this skill is present in `.claude/skills/`.

EOF

ok "iOS Pro skill created"

# ============================================================================
# Create React/TypeScript Skill
# ============================================================================
mkdir -p "$CLAUDE_DIR/skills/react-typescript"

cat > "$CLAUDE_DIR/skills/react-typescript/README.md" <<'EOF'
# React + TypeScript Pro Skill

Modern React development with TypeScript best practices (2024-2026).

## Stack

- **React 18+**: Concurrent features, Suspense, Transitions
- **TypeScript 5+**: Strict mode, no implicit any
- **Build Tools**: Vite (fast) or Next.js (full-stack)
- **State**: Zustand (simple), Jotai (atomic), TanStack Query (server)
- **Styling**: Tailwind CSS + shadcn/ui components

## Project Structure

```
src/
├── components/
│   ├── ui/              # shadcn/ui components
│   └── features/        # Feature-specific components
├── hooks/               # Custom hooks
├── lib/                 # Utilities
├── stores/              # Zustand stores
└── app/                 # Next.js app router (if using Next.js)
```

## Modern Patterns

### Server Components (Next.js App Router)
```tsx
// app/page.tsx - Server Component by default
async function HomePage() {
  const data = await fetch('https://api.example.com/data')
  const items = await data.json()

  return (
    <div>
      <h1>Home</h1>
      <ItemList items={items} />
    </div>
  )
}
```

### Client Component with Suspense
```tsx
'use client'

import { Suspense } from 'react'
import { useSuspenseQuery } from '@tanstack/react-query'

function UserProfile() {
  const { data } = useSuspenseQuery({
    queryKey: ['user'],
    queryFn: fetchUser,
  })

  return <div>{data.name}</div>
}

export default function Page() {
  return (
    <Suspense fallback={<Loading />}>
      <UserProfile />
    </Suspense>
  )
}
```

### Type-Safe State Management (Zustand)
```tsx
import { create } from 'zustand'

interface TodoStore {
  todos: Todo[]
  addTodo: (todo: Todo) => void
  removeTodo: (id: string) => void
}

const useTodoStore = create<TodoStore>((set) => ({
  todos: [],
  addTodo: (todo) => set((state) => ({
    todos: [...state.todos, todo]
  })),
  removeTodo: (id) => set((state) => ({
    todos: state.todos.filter(t => t.id !== id)
  })),
}))
```

## Essential Libraries

- **@tanstack/react-query** (40k stars) - Server state management
- **zustand** (42k stars) - Simple client state
- **react-hook-form** (40k stars) - Form handling
- **zod** (30k stars) - Runtime validation
- **tailwindcss** (78k stars) - Utility CSS
- **shadcn/ui** - Copy-paste components (Radix + Tailwind)

## TypeScript Best Practices

```tsx
// ✅ Strict typing
interface User {
  id: string
  name: string
  email: string
}

// ✅ Discriminated unions for variants
type Result<T> =
  | { status: 'success'; data: T }
  | { status: 'error'; error: string }
  | { status: 'loading' }

// ✅ Generic components
interface ListProps<T> {
  items: T[]
  renderItem: (item: T) => React.ReactNode
}

function List<T>({ items, renderItem }: ListProps<T>) {
  return <>{items.map(renderItem)}</>
}
```

## Performance Optimization

1. **Code Splitting**: Use dynamic imports
   ```tsx
   const HeavyComponent = lazy(() => import('./HeavyComponent'))
   ```

2. **Memoization**: Only when needed
   ```tsx
   const expensiveValue = useMemo(() => computeExpensive(data), [data])
   ```

3. **Virtualization**: For long lists
   ```tsx
   import { useVirtualizer } from '@tanstack/react-virtual'
   ```

## Common Pitfalls

1. ❌ Using `any` type
   ✅ Use `unknown` and narrow with type guards

2. ❌ Not using Suspense with async components
   ✅ Wrap in `<Suspense>` boundary

3. ❌ Client-side data fetching in Next.js
   ✅ Use Server Components for initial data

4. ❌ Prop drilling
   ✅ Use Zustand or React Context

## Activation

This skill is automatically available when `.claude/skills/react-typescript/` exists.

EOF

ok "React TypeScript skill created"

# ============================================================================
# Create SEO Optimization Skill
# ============================================================================
mkdir -p "$CLAUDE_DIR/skills/seo-optimization/references"
mkdir -p "$CLAUDE_DIR/skills/seo-optimization/scripts"

cat > "$CLAUDE_DIR/skills/seo-optimization/SKILL.md" <<'SEOEOF'
---
name: seo-optimization
description: Optimize website performance, accessibility, SEO, and best practices targeting Lighthouse 100 scores. This skill should be used when auditing PageSpeed/Lighthouse scores, fixing WCAG color contrast issues, resolving form accessibility problems, making links crawlable, fixing canonical URLs, validating robots.txt/sitemap.xml, optimizing fonts and images, implementing lazy loading, adding JSON-LD structured data, or improving Core Web Vitals (LCP, CLS, FID/INP).
version: 1.0.0
---

# SEO & Website Optimization Skill

Audit and fix web performance, accessibility, SEO, and best practices using Lighthouse CLI.

## Workflow

### 1. Audit with Lighthouse CLI
```bash
npx lighthouse <URL> --output=json --output-path=./lighthouse-report.json --chrome-flags="--headless --no-sandbox"
npx lighthouse <URL> --preset=desktop --output=json --output-path=./lighthouse-desktop.json --chrome-flags="--headless --no-sandbox"
```

Parse scores: `jq '.categories | to_entries[] | {(.key): .value.score}' lighthouse-report.json`
Parse failures: `jq '[.audits | to_entries[] | select(.value.score != null and .value.score < 1)] | sort_by(.value.score) | .[:20] | .[] | {id: .key, score: .value.score, title: .value.title}' lighthouse-report.json`

### 2. Fix Issues by Category
- **Accessibility** → `references/accessibility.md` (contrast, labels, headings, ARIA)
- **SEO** → `references/seo-technical.md` (canonical, robots, crawlable links, meta)
- **Performance** → `references/performance.md` (fonts, images, lazy loading, caching)
- **Structured Data** → `references/structured-data.md` (JSON-LD schemas)

### 3. Verify & Deploy
After fixes: rebuild → redeploy → re-run Lighthouse → confirm scores reach target.
Use parallel agents for independent fix categories.

## Quick Reference: Common Lighthouse Failures

| Audit ID | Category | Fix Reference |
|---|---|---|
| color-contrast | A11y | `references/accessibility.md` |
| label | A11y | `references/accessibility.md` |
| crawlable-anchors | SEO | `references/seo-technical.md` |
| link-text | SEO | `references/seo-technical.md` |
| canonical | SEO | `references/seo-technical.md` |
| largest-contentful-paint | Perf | `references/performance.md` |
SEOEOF

cat > "$CLAUDE_DIR/skills/seo-optimization/references/accessibility.md" <<'ACCEOF'
# Accessibility Fixes (WCAG AA)

## Color Contrast
WCAG AA: **4.5:1** normal text, **3:1** large text (>=18.66px bold or >=24px).

| Original | Replacement | Ratio on white | Context |
|---|---|---|---|
| `#EC1E24` | `#E31C22` | 4.73:1 | Brand red on white bg |
| `#888` | `#767676` | 4.54:1 | Placeholder on white bg |
| `#888` | `#B0B0B0` | 4.65:1 on `#3D3D3D` | Light text on dark bg |

Fix: grep for color hex codes, replace with compliant alternatives. Check both 3-digit and 6-digit forms.

## Form Labels
Every input needs label association:
- Explicit: `<label htmlFor="id">` + `<input id="id">`
- Implicit: `<label><input/></label>`
- ARIA: `<input aria-label="description">`

## Heading Order
No skipping levels: h1 -> h2 -> h3. One h1 per page.

## Select Element Labels
Every `<select>` needs `<label htmlFor>`, `aria-label`, or `aria-labelledby`.
ACCEOF

cat > "$CLAUDE_DIR/skills/seo-optimization/references/seo-technical.md" <<'SEOTECH'
# Technical SEO Fixes

## Canonical URL
Must match accessed domain. Next.js: set `metadataBase` in layout metadata.
Common issue: env var trailing newline. Use `printf` not `echo` for CLI env var setting.

## robots.txt
Next.js: `src/app/robots.ts` with rules + sitemap URL from env var.

## Crawlable Links
Must be `<a href="...">`. Invalid: `<button>` wrapping `<a>`, `<a>` without href.
Fix: `<div role="button">` + proper `<a href>`.

## Descriptive Link Text
"Learn more" fails. Fix: "Learn more about [topic]" or use `aria-label`.

## Meta Tags
- `<title>`: 50-60 chars, `<meta description>`: 150-160 chars
- `<meta viewport>`: width=device-width, initial-scale=1
SEOTECH

cat > "$CLAUDE_DIR/skills/seo-optimization/references/performance.md" <<'PERFEOF'
# Performance Optimization

## Fonts
Self-host with next/font. Use `display: swap`. Limit weights to actual usage.

## Images
Next.js Image: `sizes` prop for fill images. `priority` for above-fold. Default lazy loading.

## LCP (< 2.5s)
Preload LCP image. Use `priority` on hero images. Minimize TTFB.

## CLS (< 0.1)
Set width/height on images. Reserve space for dynamic content. Use `font-display: swap`.

## Script Loading
Next.js Script: `afterInteractive` for analytics, `lazyOnload` for low-priority.

## Caching
Static assets: `Cache-Control: public, max-age=31536000, immutable`.
PERFEOF

cat > "$CLAUDE_DIR/skills/seo-optimization/references/structured-data.md" <<'SDEOF'
# Structured Data (JSON-LD)

## Common Schemas
- Organization: name, url, logo, contactPoint, sameAs
- LocalBusiness: address, telephone, openingHours
- Product: name, description, brand, offers
- FAQPage: mainEntity with Question/Answer pairs
- BreadcrumbList: itemListElement with position, name, item

## Next.js Implementation
Use `<script type="application/ld+json">` with `dangerouslySetInnerHTML`.
Validate: https://search.google.com/test/rich-results
SDEOF

cat > "$CLAUDE_DIR/skills/seo-optimization/scripts/lighthouse-audit.sh" <<'LHEOF'
#!/usr/bin/env bash
set -euo pipefail
URL="${1:?Usage: lighthouse-audit.sh <URL> [desktop|mobile|both]}"
MODE="${2:-both}"
FLAGS="--headless --no-sandbox --disable-gpu"
run_audit() {
  local p="$1" o="$2" f="--output=json --output-path=$o --chrome-flags=\"$FLAGS\""
  [ "$p" = "desktop" ] && f="$f --preset=desktop"
  echo "Running $p audit..."
  eval npx lighthouse "$URL" $f 2>/dev/null
  jq -r '.categories | to_entries[] | "  \(.key): \(.value.score * 100)%"' "$o"
}
case "$MODE" in
  desktop) run_audit "desktop" "lighthouse-desktop.json" ;;
  mobile) run_audit "mobile" "lighthouse-mobile.json" ;;
  both) run_audit "desktop" "lighthouse-desktop.json"; run_audit "mobile" "lighthouse-mobile.json" ;;
esac
LHEOF
chmod +x "$CLAUDE_DIR/skills/seo-optimization/scripts/lighthouse-audit.sh"

ok "SEO Optimization skill created"

